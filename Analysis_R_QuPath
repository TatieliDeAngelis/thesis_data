# Helper to convert p to *
get_significance <- function(p_value) {
  if (p_value < 0.001) return("***")
  else if (p_value < 0.01) return("**")
  else if (p_value < 0.05) return("*")
  else return("")
}

# Extract p-values in matching order
extract_tukey_stars <- function(tukey_df, comparison_list) {
  sapply(comparison_list, function(comp) {
    name1 <- paste(comp[2], comp[1], sep = "-")  # Tukey outputs reverse order!
    name2 <- paste(comp[1], comp[2], sep = "-")
    if (name1 %in% rownames(tukey_df)) {
      get_significance(tukey_df[name1, "p adj"])
    } else if (name2 %in% rownames(tukey_df)) {
      get_significance(tukey_df[name2, "p adj"])
    } else {
      ""
    }
  })
}

