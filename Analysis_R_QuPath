# Helper function to calculate mean ± SEM
summary_stats <- function(data, variable) {
  data %>%
    group_by(Age) %>%
    summarise(
      Mean = mean(.data[[variable]], na.rm = TRUE),
      SEM = sd(.data[[variable]], na.rm = TRUE) / sqrt(n())
    ) %>%
    mutate(Formatted = sprintf("%.2f ± %.2f", Mean, SEM)) %>%
    select(Age, Formatted)
}

# Summarize each variable
plaque_density <- summary_stats(plaques, "Plaque_Density")
plaque_area <- summary_stats(plaques, "Plaque_Area_Density")
microglia_density <- summary_stats(microglia, "Cell_Density")
microglia_area <- summary_stats(microglia, "Cell_Area_Density")

# Combine all summaries
table_data <- plaque_density %>%
  full_join(plaque_area, by = "Age") %>%
  full_join(microglia_density, by = "Age") %>%
  full_join(microglia_area, by = "Age") %>%
  arrange(match(Age, c("WT", "2m", "4m", "6m")))

# Generate GT table
