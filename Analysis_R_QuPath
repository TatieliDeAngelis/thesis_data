file_names <- list.files(pattern = "Exported_Data_.*_Normalized.csv")

load_and_clean <- function(file) {
  df <- read_delim(file, delim = ";", show_col_types = FALSE)
  MO <- str_extract(file, "MO\\d+")
  
  age <- case_when(
    MO %in% c("MO25", "MO26", "MO27", "MO28") ~ "WT",
    MO %in% c("MO18", "MO29", "MO30") ~ "2m",
    MO %in% c("MO20", "MO31", "MO32") ~ "4m",
    MO %in% c("MO33", "MO34", "MO35") ~ "6m",
    TRUE ~ "Unknown"
  )
  
  df$Mouse <- MO
  df$Age <- age
  return(df)
}

all_data <- lapply(file_names, load_and_clean) %>% bind_rows()

